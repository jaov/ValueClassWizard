<#assign licenseFirst = "/*">
<#assign licensePrefix = " * ">
<#assign licenseLast = " */">
<#include "${project.licensePath}">

<#if package?? && package != "">
package ${package};

</#if>
<#if imports?? && imports?has_content>
<#list imports as imp>
import ${imp};
</#list>

</#if>
/**
 * Immutable value class.
 *
 * @author ${user}
 */
public final class ${name} {

<#list fields as field>
    private final ${field.type} ${field.name};
</#list>

    public ${name}(<#list fields as field>${field.type} ${field.name}<#if field_has_next>, </#if></#list>) {
<#list fields as field>
        this.${field.name} = ${field.name};
</#list>
    }

<#list fields as field>
    public ${field.type} get${field.name?cap_first}() {
        return this.${field.name};
    }

</#list>
<#list fields as field><#if field.wither>
    public ${name} with${field.name?cap_first}(${field.type} ${field.name}) {
        return new ${name}(<#list fields as argument><#if argument.name == field.name>${field.name}<#else>this.${argument.name}</#if><#if argument_has_next>, </#if></#list>);
    }

</#if></#list>
<#if (builder?? && builder) && fields?has_content>
    public static Has${fields[0].name?cap_first} builder() {
        return new Builder();
    }

<#list fields as field>
    public interface Has${field.name?cap_first} {
        <#if field_has_next>Has${fields[field_index + 1].name?cap_first}<#else>CanBuild</#if> set${field.name?cap_first}(${field.type} ${field.name});
    }

</#list>
    public interface CanBuild {
        ${name} build();
    }

    private static final class Builder implements <#list fields as field>Has${field.name?cap_first}<#if field_has_next>, </#if></#list>, CanBuild {

        private Builder() {
        }

<#list fields as field>
        private ${field.type} ${field.name};
</#list>

<#list fields as field>
        @Override
        public <#if field_has_next>Has${fields[field_index + 1].name?cap_first}<#else>CanBuild</#if> set${field.name?cap_first}(${field.type} ${field.name}) {
            this.${field.name} = ${field.name};
            return this;
        }

</#list>
        @Override
        public ${name} build() {
            return new ${name}(<#list fields as field>this.${field.name}<#if field_has_next>, </#if></#list>);
        }
    }

</#if>
    @Override
    public boolean equals(Object o) {
        if (this == o) {
            return true;
        }
        if (o == null || getClass() != o.getClass()) {
            return false;
        }
        ${name} that = (${name}) o;
        return <#if fields?size == 0>true<#else><#list fields as field>java.util.Objects.equals(this.${field.name}, that.${field.name})<#if field_has_next>
                && </#if></#list></#if>;
    }

    @Override
    public int hashCode() {
        return java.util.Objects.hash(<#list fields as field>this.${field.name}<#if field_has_next>, </#if></#list>);
    }

    @Override
    public String toString() {
<#if fields?size == 0>
        return "${name}{}";
<#else>
        return "${name}{" +
<#list fields as field>
                "${field.name}=" + this.${field.name}<#if field_has_next> + ", " +<#else> + '}';</#if>
</#list>
</#if>
    }
}
